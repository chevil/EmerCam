<?xml version="1.0" encoding="utf-8"?>
<selector
  xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true" >
        <shape android:shape="rectangle">
            <stroke android:width="2.0dip" android:color="#1b496c" />
            <corners android:radius="10.0dip" />
        <gradient
            android:startColor="#76beec"
            android:endColor="#257cb3"
            android:angle="90" />
        </shape>
    </item>
    <item android:state_pressed="false" >
        <shape android:shape="rectangle">
            <stroke android:width="2.0dip" android:color="#1b496c" />
            <corners android:radius="10.0dip" />
        <gradient
            android:startColor="#257cb3"
            android:endColor="#76beec"
            android:angle="90" />
        </shape>
    </item>
</selector>
